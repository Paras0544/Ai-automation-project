# Copy this file to .env and fill it in. Never commit .env.
GEMINI_API_KEY=
# Run "npm run models" to see what your key can use, then set one here
GEMINI_MODEL=gemini-3.5-flash

# Free AI fit images (Cloudflare Workers AI, free 10,000 neurons/day, no card)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Pinterest (developers.pinterest.com → My apps). Then run: npm run pinterest:login
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# PINS_PER_RUN=2
